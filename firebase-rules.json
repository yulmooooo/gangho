{
  "rules": {
    "rankings": {
      ".read": true,
      ".indexOn": ["power", "dailyKey", "weeklyKey", "monthlyKey"],
      "$recordId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'sect', 'power', 'rankName', 'age', 'avatarId', 'dailyKey', 'weeklyKey', 'monthlyKey', 'createdAt'])",
        "name":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && !newData.val().matches(/[<>]/)" },
        "sect":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && !newData.val().matches(/[<>]/)" },
        "power":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
        "rankName":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "age":       { ".validate": "newData.isNumber() && newData.val() >= 16 && newData.val() <= 150" },
        "avatarId":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "path":      { ".validate": "newData.isString() && (newData.val() === 'orthodox' || newData.val() === 'unorthodox' || newData.val() === 'demonic' || newData.val() === 'neutral')" },
        "dailyKey":  { ".validate": "newData.isString() && newData.val().length <= 12" },
        "weeklyKey": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "monthlyKey":{ ".validate": "newData.isString() && newData.val().length <= 8" },
        "sectPower": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "sectLevel": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
        "discipleCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        "heirName":  { ".validate": "newData.isString() && newData.val().length <= 12" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    }
  }
}
